# ══════════════════════════════════════════════════════════════
#  Copy file này thành `.env` rồi điền giá trị thật.
#  KHÔNG BAO GIỜ commit `.env` — đã có trong .gitignore.
# ══════════════════════════════════════════════════════════════

# ─── PostgreSQL (dùng chung cho service postgres và backend) ───
POSTGRES_USER=f8user
POSTGRES_PASSWORD=
POSTGRES_DB=f8_topcv
POSTGRES_PORT=5432

# ─── Backend ───
APP_ENV=development
BACKEND_PORT=8000
# Sinh khoá ngẫu nhiên: openssl rand -hex 32
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# ─── AWS S3 (dùng từ phase P5, để trống ở P0) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=

# ─── VietQR (dùng từ phase P2, không cần API key) ───
VIETQR_BASE_URL=https://api.vietqr.io/v2
VIETQR_TIMEOUT_SECONDS=10
